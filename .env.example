# Banco de dados
# DATABASE_URL: conexão via pooler (pgbouncer) — usada pela aplicação em runtime
# DIRECT_URL: conexão direta — usada apenas por `prisma migrate`/introspect
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/i9_auto?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/i9_auto?schema=public"

# Autenticação
JWT_SECRET="troque-este-valor-por-um-segredo-forte-gerado-aleatoriamente"
SESSION_DURATION_HOURS=12

# Modo da aplicação: mock (padrão em dev) | production
APP_MODE="mock"

# RENAVE (preencher somente quando formos integrar de verdade — nunca commitar valores reais)
# Autenticação real é via mTLS (certificado de máquina, tipo Pessoa Jurídica) —
# não há client_id/secret. RENAVE_CERTIFICADO_PFX_BASE64 é o .pfx codificado em
# base64 (nunca commitar; usar somente como env var na Vercel/local .env).
#
# RENAVE_ENVIRONMENT aceita MOCK | HOMOLOGACAO | PRODUCAO. HOMOLOGACAO usa o
# mesmo código real (mTLS), só aponta pra outra URL — confirmado pelo suporte
# do RENAVE em 2026-09-18: existe ambiente de testes com os mesmos endpoints,
# exige certificado de CNPJ com CNAE automotivo (guia oficial em
# renave.estaleiro.serpro.gov.br/renave-ws/manual/dicas-ssl).
# Em HOMOLOGACAO, o certificado do servidor tem CN diferente do host "hom.",
# por isso é preciso RENAVE_TLS_SERVERNAME apontando pro CN certo.
RENAVE_ENVIRONMENT="MOCK"
RENAVE_BASE_URL="renave.estaleiro.serpro.gov.br"
# Para homologação, use:
# RENAVE_BASE_URL="hom.renave.estaleiro.serpro.gov.br"
# RENAVE_TLS_SERVERNAME="estaleiro.serpro.gov.br"
RENAVE_TLS_SERVERNAME=""
# Preferido: certificado + chave em PEM separados, em vez do .pfx (PKCS12)
# inteiro — o runtime de função da Vercel não conseguiu interpretar PKCS12
# (erro ERR_CRYPTO_UNSUPPORTED_OPERATION, confirmado em teste ao vivo em
# 2026-09-18), mesmo com --openssl-legacy-provider. Gere localmente com:
#   openssl pkcs12 -in certificado.pfx -clcerts -nokeys -out cert.pem
#   openssl pkcs12 -in certificado.pfx -nocerts -nodes -out key.pem
# e converta cada .pem pra base64 (mesmo processo do .pfx).
RENAVE_CERTIFICADO_CERT_BASE64=""
RENAVE_CERTIFICADO_KEY_BASE64=""
# Alternativa (só funciona se a Vercel passar a suportar PKCS12 no futuro):
RENAVE_CERTIFICADO_PFX_BASE64=""
RENAVE_CERTIFICADO_SENHA=""

# Fiscal — provedor Notaas (notaas.com.br), plano gratuito (50 notas/mês)
# Deixe FISCAL_ENVIRONMENT=MOCK até validar a emissão no sandbox deles.
FISCAL_ENVIRONMENT="MOCK"
NOTAAS_API_KEY=""

# CFOP/ICMS confirmados para Pernambuco (SEFAZ-PE, Decreto 44.650/2017,
# art. 13, Anexo 3, art. 17): entrada CFOP 1102, saída CFOP 5102 com 20% de
# redução de base de cálculo do ICMS (CST 20) quando a entrada não foi
# tributada (compra de pessoa física). NCM ainda é só um palpite — confirmar
# com a contadora antes de ligar produção.
FISCAL_NCM_VEICULO="87032310"
FISCAL_CFOP_ENTRADA="1102"
FISCAL_CFOP_SAIDA="5102"
FISCAL_ICMS_CST_SAIDA="20"
FISCAL_ICMS_REDUCAO_BASE_SAIDA="20"

# Storage de documentos (fotos, XML, comprovantes)
# "local" salva em ./storage (dev). Em produção na Vercel, conecte um Blob
# Store (Storage → Create Database → Blob) que o BLOB_READ_WRITE_TOKEN abaixo
# é preenchido automaticamente e o driver muda para Vercel Blob sozinho.
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
