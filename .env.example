# Banco de dados
# DATABASE_URL: conexão via pooler (pgbouncer) — usada pela aplicação em runtime
# DIRECT_URL: conexão direta — usada apenas por `prisma migrate`/introspect
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/i9_auto?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/i9_auto?schema=public"

# Autenticação
JWT_SECRET="troque-este-valor-por-um-segredo-forte-gerado-aleatoriamente"
SESSION_DURATION_HOURS=12

# Modo da aplicação: mock (padrão em dev) | production
APP_MODE="mock"

# RENAVE (preencher somente quando formos integrar de verdade — nunca commitar valores reais)
RENAVE_ENVIRONMENT="MOCK"
RENAVE_BASE_URL=""
RENAVE_CLIENT_ID=""
RENAVE_CLIENT_SECRET=""
RENAVE_CERTIFICATE_PATH=""

# Fiscal / SEFAZ (preencher somente quando definirmos o provedor)
FISCAL_ENVIRONMENT="MOCK"
FISCAL_PROVIDER_BASE_URL=""
FISCAL_CERTIFICATE_PATH=""

# Storage de documentos (fotos, XML, comprovantes)
# "local" salva em ./storage (dev). Em produção na Vercel, conecte um Blob
# Store (Storage → Create Database → Blob) que o BLOB_READ_WRITE_TOKEN abaixo
# é preenchido automaticamente e o driver muda para Vercel Blob sozinho.
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
